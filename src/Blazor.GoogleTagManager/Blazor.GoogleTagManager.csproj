<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
	  <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
	  <NoWarn>1591;1701;1702;SA1134</NoWarn>
	  <Nullable>enable</Nullable>
	  <LangVersion>latest</LangVersion>
	  <IsTrimmable>true</IsTrimmable>
	  <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
	  <BunRuntimeDownload>true</BunRuntimeDownload>
	  <BunVersionDownload>1.3.14</BunVersionDownload>
	  <BunRuntimeDirectory>$(MSBuildProjectDirectory)\..\..\artifacts\bun-runtime</BunRuntimeDirectory>
	</PropertyGroup>
	
	<PropertyGroup>
	  <IsPackable>true</IsPackable>
	  <Authors>ScarletKuro</Authors>
	  <Description>Google Tag Manager implementation for Blazor. This is a fork of Havit.Blazor.GoogleTagManager with some enchantments like package size and trim support.</Description>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <RepositoryUrl>https://github.com/ScarletKuro/Blazor.GoogleTagManager</RepositoryUrl>
	  <PackageTags>GTM, Analytics, Blazor, Google, Tag, Manager</PackageTags>
	  <PackageIcon>google-tag-mager-icon.png</PackageIcon>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>

	<PropertyGroup>
	  <PublishRepositoryUrl>true</PublishRepositoryUrl>
	  <EmbedUntrackedSources>true</EmbedUntrackedSources>
	  <IncludeSymbols>true</IncludeSymbols>
	  <SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
	  <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup> 

	<ItemGroup>
	  <None Include="..\..\google-tag-mager-icon.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\..\CHANGELOG.md">
	    <Pack>False</Pack>
	  </None>
	</ItemGroup>

	<ItemGroup>
	  <SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="6.0.0" />
	  <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
	  <PackageReference Include="Nerdbank.GitVersioning" Version="3.6.133" PrivateAssets="all" />
	  <PackageReference Include="Scarlet.Bun.MSBuild" Version="1.0.0-preview.3" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
	</ItemGroup>

	<PropertyGroup>
	  <RunBunTargets Condition="'$(DesignTimeBuild)' != 'true' AND ('$(TargetFrameworks)' == '' OR '$(TargetFramework)' == '')">true</RunBunTargets>
	</PropertyGroup>

	<UsingTask TaskName="Scarlet.Bun.MSBuild.BunRunTask"
	           AssemblyFile="$(NuGetPackageRoot)scarlet.bun.msbuild\1.0.0-preview.3\tools\netstandard2.0\Scarlet.Bun.MSBuild.dll"
	           Condition="Exists('$(NuGetPackageRoot)scarlet.bun.msbuild\1.0.0-preview.3\tools\netstandard2.0\Scarlet.Bun.MSBuild.dll')" />

	<Target Name="BunBuild"
	        BeforeTargets="DispatchToInnerBuilds;PreBuildEvent"
	        Condition="'$(RunBunTargets)' == 'true'">
	  <BunRunTask Command="build"
	              Arguments="./assets/GoogleTagManager.ts --outfile ./wwwroot/GoogleTagManager.js --target browser --format esm --minify"
	              WorkingDirectory="$(MSBuildProjectDirectory)"
	              RuntimeDirectory="$(BunRuntimeDirectory)"
	              BunRuntimeDownload="$(BunRuntimeDownload)"
	              BunVersionDownload="$(BunVersionDownload)"
	              DownloadMutexTimeoutSeconds="$(BunDownloadMutexTimeoutSeconds)" />
	</Target>

</Project>
